# docker compose variables — copy to .env and fill in. Generate secrets with: openssl rand -base64 48
APP_ENV=development
POSTGRES_PASSWORD=
JWT_SECRET=
IMAGE_URL_SECRET=
DEVICE_PEPPER=
AI_INTERNAL_TOKEN=
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081
WEB_URL=http://localhost:3000
# E-mail: outbox (dev, files) | smtp (production) — e.g. smtps://user:pass@smtp.example.com
MAIL_TRANSPORT=outbox
SMTP_URL=
MAIL_FROM=AI Room <no-reply@airoom.local>
# Image generation: mock (offline demo) | gemini | replicate | falai
IMAGE_PROVIDER=mock
# Optional fallback chain tried in order on retryable errors, e.g. replicate
IMAGE_FALLBACKS=
# Swagger UI on the backend (/docs); keep false on public deployments
SWAGGER_ENABLED=false
# Push notifications: outbox (dev) | expo (production; EXPO_ACCESS_TOKEN if enhanced push security is on)
PUSH_TRANSPORT=outbox
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
# fal.ai: FLUX.2 klein edit provider + SAM 3 masks that lock paint/floor/replace edits to their region
FAL_KEY=
# Optional: enables real Claude design chat and shopping/budget analysis (demo answers without it)
ANTHROPIC_API_KEY=
