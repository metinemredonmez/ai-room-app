# docker compose variables — copy to .env and fill in. Generate secrets with: openssl rand -base64 48
APP_ENV=development
POSTGRES_PASSWORD=
JWT_SECRET=
IMAGE_URL_SECRET=
DEVICE_PEPPER=
AI_INTERNAL_TOKEN=
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081
WEB_URL=http://localhost:3000
# E-mail: outbox (dev, files) | smtp (production) — e.g. smtps://user:pass@smtp.example.com
MAIL_TRANSPORT=outbox
SMTP_URL=
MAIL_FROM=AI Room <no-reply@airoom.local>
# Image generation: mock (offline demo) | gemini | replicate
IMAGE_PROVIDER=mock
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
# Optional: enables real Claude design chat and shopping/budget analysis (demo answers without it)
ANTHROPIC_API_KEY=
