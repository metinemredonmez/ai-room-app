# Backend API taban adresi (sunucu tarafında kullanılır; tarayıcıya açılmaz)
API_BASE_URL=http://localhost:4000/v1

# İsteğe bağlı: görsellerin sunulduğu ek origin'ler (CSP img-src). Virgülle ayırın.
# Backend PUBLIC_BASE_URL farklı bir alan adındaysa buraya ekleyin.
IMAGE_ORIGINS=

# İsteğe bağlı (üretim): panelin tam origin'i; CSRF Origin kontrolü bununla karşılaştırılır.
# ADMIN_ORIGIN=https://admin.casalume.example

# Local development only: hide the TOTP field on the login page (matches the backend ADMIN_DEV_SKIP_MFA).
# ADMIN_DEV_SKIP_MFA=true
