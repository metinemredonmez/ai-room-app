{
  "expo": {
    "name": "Casalume",
    "slug": "casalume",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "casalume",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.casalume",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.casalume",
      "adaptiveIcon": {
        "backgroundColor": "#1F6F5C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1F6F5C",
          "defaultChannel": "designs"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Casalume, yeniden tasarlamak istediğin oda fotoğraflarını seçebilmen için fotoğraflarına erişir.",
          "cameraPermission": "Casalume, odanın fotoğrafını çekip yeniden tasarlayabilmen için kameraya erişir.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6F5C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
