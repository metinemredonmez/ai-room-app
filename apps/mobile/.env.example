# Backend API base URL (docs/API.md). On a physical device use your computer's LAN IP,
# e.g. http://192.168.1.20:4000/v1 — "localhost" only works in the iOS simulator and on web.
EXPO_PUBLIC_API_URL=http://localhost:4000/v1

# RevenueCat public SDK keys (App Store / Google Play). Empty = demo upgrade (development only).
# Store billing needs a development or store build (npx expo run:ios / eas build) — not Expo Go.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
