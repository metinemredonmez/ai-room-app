// Casalume — backend data model (PostgreSQL)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Admin roles are hierarchical: SUPPORT < EDITOR < ADMIN < SUPER_ADMIN (src/admin/roles.ts).
enum Role {
  USER
  SUPPORT
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum Plan {
  FREE
  PRO
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ImageKind {
  UPLOAD
  SAMPLE
  RESULT
}

enum EmailTokenPurpose {
  RESET_PASSWORD
  VERIFY_EMAIL
}

enum ChargeState {
  HELD
  CAPTURED
  RELEASED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum DataRequestStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum DesignStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// SERVICE: information about the user's own use of the app; MARKETING: commercial message (consent + weekly cap).
enum BroadcastKind {
  SERVICE
  MARKETING
}

/// PUSH: Expo notification to the user's devices; EMAIL: e-mail to the user's verified address.
enum BroadcastChannel {
  PUSH
  EMAIL
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
  CANCELLED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String?    @unique
  emailVerifiedAt   DateTime?
  passwordHash      String?
  name              String?
  role              Role       @default(USER)
  status            UserStatus @default(ACTIVE)
  isGuest           Boolean    @default(true)
  deviceHash        String?    @unique
  plan              Plan       @default(FREE)
  planExpiresAt     DateTime?
  storeProUntil     DateTime? // App Store / Play entitlement synced from RevenueCat (separate from admin/dev grants)
  credits           Int        @default(0)
  freeUsedOn        String? // YYYY-MM-DD, Europe/Istanbul
  freeUsedCount     Int        @default(0)
  locale            String     @default("tr")
  totpSecret        String?
  totpLastStep      BigInt?
  totpPendingSecret String? // TOTP enrollment in progress (confirmed with a first code)
  mfaEnrollBefore   DateTime? // set on promotion / MFA reset: enrollment window (AUT-04)
  tokenVersion      Int        @default(0) // bumped to revoke every access token (SES-04)
  lastSeenAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  emailTokens         EmailToken[]
  consents            Consent[]
  reports             ContentReport[]
  subscriptions       Subscription[]
  purchases           StorePurchase[]
  pushTokens          PushToken[]
  backupCodes         AdminBackupCode[]
  identities          AuthIdentity[]
  dataRequests        DataRequest[]
  supportTickets      SupportTicket[]
  orgMemberships      OrgMember[]
  images              Image[]
  designs             Design[]
  ledger              CreditLedger[]
  promoRedemptions    PromoRedemption[]
  referralCode        ReferralCode?
  referralsMade       Referral[]          @relation("inviter")
  referredBy          Referral?           @relation("invitee")
  giftsReceived       GiftRecipient[]
  partnerAttribution  PartnerAttribution?
  audits              AuditLog[]          @relation("actor")
  broadcastDeliveries BroadcastDelivery[]
  broadcasts          Broadcast[]         @relation("broadcastAuthor")

  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

// AUT-03: single-use, purpose-bound, short-lived; only the SHA-256 of the token is stored and the
// address it was sent to is pinned so a token dies if the account e-mail changes.
model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  purpose   EmailTokenPurpose
  email     String
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Image {
  id        String    @id @db.Uuid
  ownerId   String    @db.Uuid
  kind      ImageKind
  width     Int
  height    Int
  bytes     Int
  designId  String?   @db.Uuid
  createdAt DateTime  @default(now())
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  design    Design?   @relation("results", fields: [designId], references: [id], onDelete: Cascade)
  inputFor  Design[]  @relation("input")

  @@index([ownerId, createdAt])
  @@index([designId])
}

model Design {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  tool         String
  styleId      String?
  roomId       String?
  params       Json            @default("{}")
  prompt       String?
  provider     String?
  status       DesignStatus    @default(PENDING)
  error        String?
  inputImageId String          @db.Uuid
  creditsUsed  Int             @default(0)
  freeUsed     Int             @default(0)
  chargeDay    String?
  chargeState  ChargeState?
  queuedAt     DateTime?
  startedAt    DateTime?
  favorite     Boolean         @default(false)
  featured     Boolean         @default(false)
  /// Made in a firm's workspace (API.md §7.23): charged to the firm's pool, visible only while the maker is a member.
  orgId        String?         @db.Uuid
  /// In a firm project (step 4): the whole team sees it. The composite key (projectId, orgId) means a design can
  /// only sit in a project of its own firm, enforced by the database too (AZ-02).
  projectId    String?         @db.Uuid
  createdAt    DateTime        @default(now())
  finishedAt   DateTime?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  org          Organization?   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  project      Project?        @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Restrict)
  inputImage   Image           @relation("input", fields: [inputImageId], references: [id], onDelete: Cascade)
  results      Image[]         @relation("results")
  analyses     Analysis[]
  reports      ContentReport[]
  usages       AiUsage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([featured])
  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
}

model Analysis {
  id        String   @id @default(uuid()) @db.Uuid
  designId  String   @db.Uuid
  imageId   String   @db.Uuid
  data      Json
  createdAt DateTime @default(now())
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, imageId])
}

model Style {
  id            String   @id
  nameTr        String
  nameEn        String
  descriptionTr String
  descriptionEn String
  prompt        String
  palette       String[]
  isPro         Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CreditLedger {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?
  meta       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// Cost ledger: one row per AI service call (usage reported by the AI service).
model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  kind         String // generate | analyze | chat | describe | segment | marketing
  provider     String
  model        String
  images       Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  fallbackUsed Boolean  @default(false)
  userId       String?  @db.Uuid
  designId     String?  @db.Uuid
  createdAt    DateTime @default(now())
  design       Design?  @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([provider, createdAt])
}

// Runtime settings (typed defaults live in code; rows only store overrides).
model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
}

// Influencer / partner links (API.md §7.33): casalume.app/p/<slug>. Measurement only (a reward for the audience is a
// promo code, §7.29). Visits are counted per Istanbul day; a new account is attributed to at most one partner.
model Partner {
  id            String               @id @default(uuid()) @db.Uuid
  slug          String               @unique @db.VarChar(40)
  name          String               @db.VarChar(80)
  note          String?              @db.VarChar(300)
  // For the report only (estimated payout = net revenue × percent); payment itself is outside the system.
  commissionPct Int                  @default(0)
  active        Boolean              @default(true)
  createdById   String?              @db.Uuid
  createdAt     DateTime             @default(now())
  visits        PartnerVisitDay[]
  attributions  PartnerAttribution[]
}

model PartnerVisitDay {
  partnerId String  @db.Uuid
  day       String  @db.VarChar(10)
  count     Int     @default(0)
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([partnerId, day])
}

model PartnerAttribution {
  userId    String   @id @db.Uuid
  partnerId String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, createdAt])
}

// Group gifts (API.md §7.32): one row per send. Each recipient is a GiftRecipient row (primary key campaign+user),
// written in the same statement as the credit, so a retried or repeated run never pays anyone twice (BUS-02).
model GiftCampaign {
  id          String          @id @default(uuid()) @db.Uuid
  segment     String          @db.VarChar(40)
  days        Int?
  credits     Int
  message     String          @db.VarChar(140)
  recipients  Int             @default(0)
  pushed      Int             @default(0)
  status      String          @default("SENDING") @db.VarChar(20)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  finishedAt  DateTime?
  gifts       GiftRecipient[]

  @@index([createdAt])
}

model GiftRecipient {
  campaignId String       @db.Uuid
  userId     String       @db.Uuid
  createdAt  DateTime     @default(now())
  campaign   GiftCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([campaignId, userId])
  @@index([userId])
}

enum ReferralStatus {
  PENDING
  REWARDED
  REJECTED
}

// Invite-a-friend (API.md §7.30). One personal code per verified account.
model ReferralCode {
  userId    String   @id @db.Uuid
  code      String   @unique @db.VarChar(16)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One per invited person (keyed e-mail identity, kept after account deletion): the invitee is rewarded on claiming,
// the inviter when the invitee's first design succeeds (or never: rejected by staff or over the monthly cap).
model Referral {
  id                  String         @id @default(uuid()) @db.Uuid
  inviterId           String?        @db.Uuid
  inviteeId           String?        @unique @db.Uuid
  inviteeIdentityHash String         @unique
  status              ReferralStatus @default(PENDING)
  inviteeCredits      Int
  inviterCredits      Int
  rejectReason        String?        @db.VarChar(200)
  createdAt           DateTime       @default(now())
  rewardedAt          DateTime?
  inviter             User?          @relation("inviter", fields: [inviterId], references: [id], onDelete: SetNull)
  invitee             User?          @relation("invitee", fields: [inviteeId], references: [id], onDelete: SetNull)

  @@index([inviterId, status, rewardedAt])
  @@index([createdAt])
}

enum PromoKind {
  CREDITS
  PRO_DAYS
}

// Promotion and gift codes (API.md §7.29). A code is stored only as a keyed hash; `display` is the code itself for a
// shared campaign code the admin typed, and a masked form for generated gift codes (shown once, at creation).
// CHECK constraints (migration): amount > 0, 0 <= redeemed <= maxRedemptions.
model PromoCode {
  id             String            @id @default(uuid()) @db.Uuid
  hash           String            @unique
  display        String            @db.VarChar(40)
  campaign       String            @db.VarChar(80)
  kind           PromoKind
  amount         Int
  maxRedemptions Int?
  redeemed       Int               @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean           @default(true)
  newUsersOnly   Boolean           @default(false)
  createdById    String?           @db.Uuid
  createdAt      DateTime          @default(now())
  redemptions    PromoRedemption[]

  @@index([campaign, createdAt])
}

// One use per account and per e-mail identity (keyed hash, kept when the account is deleted, so deleting and
// signing up again does not give the code twice — same rule as welcome credits).
model PromoRedemption {
  id           String    @id @default(uuid()) @db.Uuid
  codeId       String    @db.Uuid
  userId       String?   @db.Uuid
  identityHash String
  kind         PromoKind
  amount       Int
  createdAt    DateTime  @default(now())
  code         PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([codeId, identityHash])
  @@unique([codeId, userId])
  @@index([userId])
}

// Image prompt template versions from the admin (API.md §7.26). Append-only history; which one is live is the
// `ai.prompts` Setting row (key → version id). A key with no live version uses the AI service's default.
model PromptVersion {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @db.VarChar(40)
  text        String
  note        String   @db.VarChar(200)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([key, createdAt])
}

// Append-only consent log (KVKK): the latest row per kind is the current state.
model Consent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  kind      String // terms | privacy | ai_processing | marketing
  version   String
  granted   Boolean
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

model ContentReport {
  id         String       @id @default(uuid()) @db.Uuid
  designId   String       @db.Uuid
  reporterId String?      @db.Uuid
  reason     String
  note       String?
  status     ReportStatus @default(OPEN)
  resolution String?
  resolvedBy String?      @db.Uuid
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  design     Design       @relation(fields: [designId], references: [id], onDelete: Cascade)
  reporter   User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// Execution log of scheduled jobs (cron tracker).
model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  status     String // ok | error
  details    Json      @default("{}")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([name, startedAt])
}

// RevenueCat webhook inbox: stored after signature verification, processed by the queue, never twice.
model WebhookEvent {
  id          String    @id // RevenueCat event.id (retries reuse it)
  source      String
  type        String
  appUserId   String?
  userId      String?   @db.Uuid
  status      String // queued | processed | unmatched | ignored | failed
  error       String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@index([userId, receivedAt])
}

// Store subscription state per entitlement (synced from RevenueCat).
model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  entitlement          String
  productId            String?
  store                String?
  environment          String?
  periodType           String?
  status               String // active | grace | cancelled | expired | billing_issue
  expiresAt            DateTime?
  gracePeriodExpiresAt DateTime?
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entitlement])
}

// Consumable credit packs: one row per store purchase id, so a purchase is credited exactly once.
model StorePurchase {
  id        String   @id // store transaction / purchase id
  userId    String   @db.Uuid
  productId String
  credits   Int
  store     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Expo push token of a signed-in device. Unique per device: signing into another account moves it.
model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String // ios | android
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use admin MFA recovery codes; only an HMAC (DEVICE_PEPPER) of each code is stored.
model AdminBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sign in with Apple / Google: one row per provider account, always resolving to the same user.
model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String // google | apple
  subject         String // the provider's stable user id (sub)
  clientId        String? // audience the identity signed in with (Apple revoke must use the same client)
  email           String?
  emailVerified   Boolean  @default(false)
  isPrivateEmail  Boolean  @default(false) // Apple "Hide My Email" relay address
  refreshTokenEnc String? // Apple refresh token, AES-256-GCM with FIELD_ENC_KEY; revoked on deletion / unlink
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

/// KVKK legal texts (#9). One row per kind + version + locale; a published row is never edited —
/// it is the text a user saw when they accepted it. Placeholders ({{controller.name}} …) are filled on read.
model LegalDocument {
  id              String    @id @default(uuid()) @db.Uuid
  kind            String // terms | privacy | ai_processing | marketing
  version         String // YYYY-MM-DD[.n]
  locale          String // tr | en
  title           String
  body            String // Markdown, no HTML
  requiresConsent Boolean   @default(true) // false: wording fix, earlier acceptances stay valid
  createdBy       String?   @db.Uuid
  publishedBy     String?   @db.Uuid
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([kind, version, locale])
  @@index([kind, publishedAt])
}

/// KVKK m.11 applications (#9): answered within 30 days (m.13). Kept after the account is deleted
/// (userId → null) as proof of how the application was handled; purged by retention after 2 years.
model DataRequest {
  id           String            @id @default(uuid()) @db.Uuid
  reference    String            @unique
  userId       String?           @db.Uuid
  type         String // info | access | transfers | rectification | erasure | third_party_notice | objection | compensation | other
  channel      String            @default("app") // app | email | kep | letter | other
  contactEmail String?
  details      String
  status       DataRequestStatus @default(RECEIVED)
  receivedAt   DateTime          @default(now())
  dueAt        DateTime
  response     String?
  handledBy    String?           @db.Uuid
  closedAt     DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([userId, createdAt])
}

/// Admin "Toplu Gönderim" (fal-app broadcast, sent through Expo push). Counters are denormalised from the
/// deliveries so the list stays cheap; the deliveries are the source of truth for the report.
model Broadcast {
  id           String              @id @default(uuid()) @db.Uuid
  title        String
  body         String
  link         String? // in-app path, e.g. /studio
  kind         BroadcastKind       @default(SERVICE)
  channel      BroadcastChannel    @default(PUSH)
  audience     Json // AudienceSchema (src/broadcasts/broadcast.rules.ts)
  status       BroadcastStatus     @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  targetCount  Int                 @default(0)
  sentCount    Int                 @default(0)
  skippedCount Int                 @default(0)
  failedCount  Int                 @default(0)
  openedCount  Int                 @default(0)
  error        String?
  createdById  String?             @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    User?               @relation("broadcastAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries   BroadcastDelivery[]

  @@index([status, scheduledAt])
  @@index([createdAt])
}

/// One row per recipient: what happened to the message for this user and whether it was opened.
model BroadcastDelivery {
  id          String         @id @default(uuid()) @db.Uuid
  broadcastId String         @db.Uuid
  userId      String         @db.Uuid
  status      DeliveryStatus @default(PENDING)
  reason      String? // no_device | consent_missing | weekly_cap | provider_error | interrupted | cancelled
  devices     Int            @default(0)
  sentAt      DateTime?
  openedAt    DateTime?
  createdAt   DateTime       @default(now())
  broadcast   Broadcast      @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([broadcastId, status])
  @@index([userId, sentAt])
}

enum MarketingDraftStatus {
  PENDING
  READY
  FAILED
  APPROVED
  ARCHIVED
}

/// Admin "Pazarlama" (API.md §7.18): AI drafts the owner reviews and edits. Nothing is published from here; an
/// APPROVED draft is the current text for its kind + locale (approving a new one archives the old one).
model MarketingDraft {
  id           String               @id @default(uuid()) @db.Uuid
  kind         String // aso
  locale       String
  status       MarketingDraftStatus @default(PENDING)
  input        Json                 @default("{}") // owner's brief and release notes
  output       Json? // AsoListing (snake_case fields, API.md §7.18)
  violations   String[]             @default([]) // fields over the store limit
  error        String?
  costUsd      Decimal              @default(0) @db.Decimal(12, 6)
  createdById  String?              @db.Uuid
  approvedById String?              @db.Uuid
  approvedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([kind, locale, createdAt])
  @@index([status])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

/// Public blog (API.md §7.18). One row per article per language; translations share `groupId` (hreflang).
/// Written by the marketing agent as a MarketingDraft and published here when an ADMIN approves it.
model BlogPost {
  id          String     @id @default(uuid()) @db.Uuid
  groupId     String     @db.Uuid
  locale      String
  slug        String
  title       String
  description String
  body        String // Markdown subset (headings, lists, bold/italic, in-site links); rendered without HTML
  styleId     String? // cover: the style's preview photo
  status      BlogStatus @default(PUBLISHED)
  draftId     String?    @db.Uuid
  publishedBy String?    @db.Uuid
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([locale, slug])
  @@unique([groupId, locale])
  @@index([locale, status, publishedAt])
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// Support request from the app or the web (API.md §7.19). Deleted with the account (it holds personal data);
/// closed tickets are purged after 2 years. `requestId` links the error screen the user wrote from.
model SupportTicket {
  id            String           @id @default(uuid()) @db.Uuid
  reference     String           @unique
  userId        String           @db.Uuid
  category      String // bug | billing | account | design | idea | other
  subject       String
  status        SupportStatus    @default(OPEN)
  requestId     String?
  designId      String?          @db.Uuid
  platform      String? // web | ios | android
  appVersion    String?
  locale        String           @default("tr")
  userUnread    Boolean          @default(false) // a staff reply the user hasn't opened yet
  lastMessageAt DateTime         @default(now())
  closedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, createdAt])
}

model SupportMessage {
  id        String        @id @default(uuid()) @db.Uuid
  ticketId  String        @db.Uuid
  author    String // USER | STAFF
  staffId   String?       @db.Uuid
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Welcome credits (API.md §7.22): keyed hashes (HMAC) of the identities that already received them, an e-mail
/// address or an Apple/Google account. Deliberately not linked to the account: they outlive deletion, so the same
/// identity cannot collect the gift twice by deleting and signing up again. Purged after three years.
model WelcomeGrant {
  hash      String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

/// Corporate workspace (API.md §7.23): a firm with members and a shared credit pool. Firms are created and topped
/// up from the admin panel (invoiced outside the app). Access to anything a firm owns is decided by OrgMember on
/// every request, and every firm-owned row carries orgId (AZ-01/AZ-02).
model Organization {
  id               String      @id @default(uuid()) @db.Uuid
  name             String
  status           OrgStatus   @default(ACTIVE)
  credits          Int         @default(0)
  /// Default monthly credit cap for members without their own; null = no cap.
  memberMonthlyCap Int?
  /// Staff-only note (contract, invoice reference). Never shown to the firm.
  note             String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  members          OrgMember[]
  ledger           OrgLedger[]
  invites          OrgInvite[]
  designs          Design[]
  projects         Project[]

  @@index([createdAt])
}

/// One person in one firm. Exactly one OWNER per firm (kept by the service under a lock).
model OrgMember {
  orgId      String       @db.Uuid
  userId     String       @db.Uuid
  role       OrgRole      @default(MEMBER)
  /// Monthly credit cap for this member; null = the firm default.
  monthlyCap Int?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
}

/// The firm's credit pool movements: staff top-ups (actorId) and members' spending (userId).
model OrgLedger {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  delta     Int
  reason    String
  /// The member who spent (null for a staff top-up). An id only, so the firm's history survives a member leaving.
  userId    String?      @db.Uuid
  /// The staff member who changed the pool.
  actorId   String?      @db.Uuid
  refId     String?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, userId, createdAt])
}

/// An e-mail invitation to a firm (API.md §7.23 step 2). Only the token's hash is stored; the link is single-use,
/// expires after 7 days and is accepted only by a verified account with the same address.
model OrgInvite {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @db.Uuid
  email      String
  role       OrgRole      @default(MEMBER)
  monthlyCap Int?
  tokenHash  String       @unique
  /// Who sent it: a member (OWNER/ADMIN) or a staff account.
  invitedBy  String?      @db.Uuid
  expiresAt  DateTime
  acceptedAt DateTime?
  acceptedBy String?      @db.Uuid
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([email])
}

/// A firm's shared folder (API.md §7.23 step 4), e.g. one client's apartment. Designs put in a project are visible
/// to the whole team; the rest of a member's firm designs stay theirs. Projects are archived, not deleted, while
/// they hold designs.
model Project {
  id         String        @id @default(uuid()) @db.Uuid
  orgId      String        @db.Uuid
  name       String
  clientName String?
  note       String?
  status     ProjectStatus @default(ACTIVE)
  createdBy  String?       @db.Uuid
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  designs    Design[]

  @@unique([id, orgId])
  @@index([orgId, status, updatedAt])
}
