// AI Room — backend data model (PostgreSQL)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum ImageKind {
  UPLOAD
  SAMPLE
  RESULT
}

enum EmailTokenPurpose {
  RESET_PASSWORD
  VERIFY_EMAIL
}

enum ChargeState {
  HELD
  CAPTURED
  RELEASED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum DesignStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  emailVerifiedAt DateTime?
  passwordHash  String?
  name          String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  isGuest       Boolean    @default(true)
  deviceHash    String?    @unique
  plan          Plan       @default(FREE)
  planExpiresAt DateTime?
  storeProUntil DateTime? // App Store / Play entitlement synced from RevenueCat (separate from admin/dev grants)
  credits       Int        @default(0)
  freeUsedOn    String? // YYYY-MM-DD, Europe/Istanbul
  freeUsedCount Int        @default(0)
  locale        String     @default("tr")
  totpSecret    String?
  totpLastStep  BigInt?
  tokenVersion  Int        @default(0) // bumped to revoke every access token (SES-04)
  lastSeenAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  consents      Consent[]
  reports       ContentReport[]
  subscriptions Subscription[]
  purchases     StorePurchase[]
  images        Image[]
  designs       Design[]
  ledger        CreditLedger[]
  audits        AuditLog[]     @relation("actor")

  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}

// AUT-03: single-use, purpose-bound, short-lived; only the SHA-256 of the token is stored and the
// address it was sent to is pinned so a token dies if the account e-mail changes.
model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  purpose   EmailTokenPurpose
  email     String
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Image {
  id        String    @id @db.Uuid
  ownerId   String    @db.Uuid
  kind      ImageKind
  width     Int
  height    Int
  bytes     Int
  designId  String?   @db.Uuid
  createdAt DateTime  @default(now())
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  design    Design?   @relation("results", fields: [designId], references: [id], onDelete: Cascade)
  inputFor  Design[]  @relation("input")

  @@index([ownerId, createdAt])
  @@index([designId])
}

model Design {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  tool         String
  styleId      String?
  roomId       String?
  params       Json         @default("{}")
  prompt       String?
  provider     String?
  status       DesignStatus @default(PENDING)
  error        String?
  inputImageId String       @db.Uuid
  creditsUsed  Int          @default(0)
  freeUsed     Int          @default(0)
  chargeDay    String?
  chargeState  ChargeState?
  queuedAt     DateTime?
  startedAt    DateTime?
  favorite     Boolean      @default(false)
  featured     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  finishedAt   DateTime?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  inputImage   Image        @relation("input", fields: [inputImageId], references: [id], onDelete: Cascade)
  results      Image[]      @relation("results")
  analyses     Analysis[]
  reports      ContentReport[]
  usages       AiUsage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([featured])
}

model Analysis {
  id        String   @id @default(uuid()) @db.Uuid
  designId  String   @db.Uuid
  imageId   String   @db.Uuid
  data      Json
  createdAt DateTime @default(now())
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, imageId])
}

model Style {
  id            String   @id
  nameTr        String
  nameEn        String
  descriptionTr String
  descriptionEn String
  prompt        String
  palette       String[]
  isPro         Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CreditLedger {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?
  meta       Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// Cost ledger: one row per AI service call (usage reported by the AI service).
model AiUsage {
  id           String   @id @default(uuid()) @db.Uuid
  kind         String // generate | analyze | chat | describe
  provider     String
  model        String
  images       Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6)
  fallbackUsed Boolean  @default(false)
  userId       String?  @db.Uuid
  designId     String?  @db.Uuid
  createdAt    DateTime @default(now())
  design       Design?  @relation(fields: [designId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([provider, createdAt])
}

// Runtime settings (typed defaults live in code; rows only store overrides).
model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @db.Uuid
  updatedAt DateTime @updatedAt
}

// Append-only consent log (KVKK): the latest row per kind is the current state.
model Consent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  kind      String // terms | privacy | ai_processing | marketing
  version   String
  granted   Boolean
  ip        String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

model ContentReport {
  id         String       @id @default(uuid()) @db.Uuid
  designId   String       @db.Uuid
  reporterId String?      @db.Uuid
  reason     String
  note       String?
  status     ReportStatus @default(OPEN)
  resolution String?
  resolvedBy String?      @db.Uuid
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  design     Design       @relation(fields: [designId], references: [id], onDelete: Cascade)
  reporter   User?        @relation(fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// Execution log of scheduled jobs (cron tracker).
model JobRun {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  status     String // ok | error
  details    Json      @default("{}")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([name, startedAt])
}

// RevenueCat webhook inbox: stored after signature verification, processed by the queue, never twice.
model WebhookEvent {
  id          String    @id // RevenueCat event.id (retries reuse it)
  source      String
  type        String
  appUserId   String?
  userId      String?   @db.Uuid
  status      String // queued | processed | unmatched | ignored | failed
  error       String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
}

// Store subscription state per entitlement (synced from RevenueCat).
model Subscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  entitlement          String
  productId            String?
  store                String?
  environment          String?
  periodType           String?
  status               String // active | grace | cancelled | expired | billing_issue
  expiresAt            DateTime?
  gracePeriodExpiresAt DateTime?
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entitlement])
}

// Consumable credit packs: one row per store purchase id, so a purchase is credited exactly once.
model StorePurchase {
  id        String   @id // store transaction / purchase id
  userId    String   @db.Uuid
  productId String
  credits   Int
  store     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
