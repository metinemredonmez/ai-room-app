NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://USER@localhost:5432/ai_room?schema=public
REDIS_URL=redis://localhost:6379/0
# Each secret ≥ 32 chars and distinct — openssl rand -base64 48
JWT_SECRET=
IMAGE_URL_SECRET=
DEVICE_PEPPER=
# Must equal INTERNAL_TOKEN of the AI service
AI_INTERNAL_TOKEN=
AI_SERVICE_URL=http://localhost:8001
# MAIL-01: e-mailed links are built only from this origin (https in production)
WEB_APP_URL=http://localhost:3000
# outbox = write mails to DATA_DIR/outbox (development) | smtp (required in production)
MAIL_TRANSPORT=outbox
SMTP_URL=
MAIL_FROM=AI Room <no-reply@airoom.local>
DATA_DIR=./data
CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:3001
TRUSTED_PROXY_HOPS=0
FREE_DAILY_GENERATIONS=3
PRO_DAILY_GENERATIONS=100
MAX_UPLOAD_MB=10
IMAGE_URL_TTL_HOURS=24
MAX_CONCURRENT_GENERATIONS=4
# BullMQ workers in this process (false on API-only replicas)
WORKER_ENABLED=true
# Swagger UI at /docs — default: on in development, off in production
# SWAGGER_ENABLED=false
# Optional seed overrides (otherwise a random password is generated)
# ADMIN_EMAIL=admin@airoom.local
# ADMIN_PASSWORD=
