NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DATABASE_URL=postgresql://USER@localhost:5432/ai_room?schema=public
REDIS_URL=redis://localhost:6379/0
# Each secret ≥ 32 chars and distinct — openssl rand -base64 48
JWT_SECRET=
IMAGE_URL_SECRET=
DEVICE_PEPPER=
# Must equal INTERNAL_TOKEN of the AI service
AI_INTERNAL_TOKEN=
AI_SERVICE_URL=http://localhost:8001
# MAIL-01: e-mailed links are built only from this origin (https in production)
WEB_APP_URL=http://localhost:3000
# outbox = write mails to DATA_DIR/outbox (development) | smtp (required in production)
MAIL_TRANSPORT=outbox
SMTP_URL=
MAIL_FROM=AI Room <no-reply@airoom.local>
DATA_DIR=./data
# Image storage: local | s3 (Cloudflare R2 / AWS S3 / MinIO). Bucket stays private — the API streams objects
# behind its own signed URLs. Move existing files with: npm run storage:migrate
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com · MinIO / local s3rver: http://localhost:4569 (+ S3_FORCE_PATH_STYLE=true)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=images/
CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:3001
TRUSTED_PROXY_HOPS=0
FREE_DAILY_GENERATIONS=3
PRO_DAILY_GENERATIONS=100
MAX_UPLOAD_MB=10
IMAGE_URL_TTL_HOURS=24
MAX_CONCURRENT_GENERATIONS=4
# BullMQ workers in this process (false on API-only replicas)
WORKER_ENABLED=true
# Swagger UI at /docs — default: on in development, off in production
# SWAGGER_ENABLED=false
# Optional seed overrides (otherwise a random password is generated)
# ADMIN_EMAIL=admin@airoom.local
# ADMIN_PASSWORD=

# "Tasarımın hazır" push: outbox (dev, writes DATA_DIR/push-outbox) | expo (required in production)
PUSH_TRANSPORT=outbox
# Only needed when "enhanced push security" is enabled in the Expo project
EXPO_ACCESS_TOKEN=

# RevenueCat (App Store / Play subscriptions + credit packs)
# Webhook: set the same Authorization value and enable HMAC signing in the RevenueCat dashboard
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_WEBHOOK_SECRET=
# Secret API key (v1) — used to sync subscriber state after each webhook and on POST /v1/billing/sync
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT=pro
CREDIT_PACKS=airoom_credits_10:10,airoom_credits_50:50
