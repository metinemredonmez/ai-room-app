ENV=development
# Backend ile paylaşılan sır (AI_INTERNAL_TOKEN), en az 32 karakter
INTERNAL_TOKEN=

# Birincil görsel sağlayıcısı: mock | gemini | replicate | falai   (ENV=production iken mock reddedilir)
IMAGE_PROVIDER=mock
# Yedek zincir, sırayla denenir (virgülle; boş olabilir). Her birinin anahtarı tanımlı olmalı; üretimde mock olamaz.
IMAGE_FALLBACKS=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
# fal.ai: FLUX.2 [klein] edit sağlayıcısı (IMAGE_PROVIDER=falai) ve SAM 3 bölge maskesi (API.md §7.8)
FAL_KEY=
FALAI_EDIT_MODEL=fal-ai/flux-2/klein/4b/edit
FALAI_SEG_MODEL=fal-ai/sam-3/image
# Bölge kilidi: auto (boya/zemin/değiştir/hedefli silme maskeyle sınırlanır) | off
REGION_LOCK=auto

# İsteğe bağlı: Claude ile tasarım sohbeti, alışveriş/bütçe analizi ve referans stil çözümleme
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Maliyet defteri (USD) — görsel başına ve milyon token başına fiyatlar
GEMINI_IMAGE_COST_USD=0.039
REPLICATE_IMAGE_COST_USD=0.04
FALAI_IMAGE_COST_USD=0.012
FALAI_SEG_COST_USD=0.005
ANTHROPIC_INPUT_USD_PER_MTOK=4
ANTHROPIC_OUTPUT_USD_PER_MTOK=20

# Dayanıklılık: /generate toplam süre bütçesi, sağlayıcı çağrısı üst sınırı, devre kesici
GENERATE_TIME_BUDGET_S=150
PROVIDER_TIMEOUT_S=120
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_S=60
MAX_CONCURRENT_GENERATIONS=4

# Hata izleme (Sentry) — boşsa kapalı. Raporlar kişisel veri taşımaz (app/monitoring.py).
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=<git sha>
SENTRY_TRACES_SAMPLE_RATE=0
