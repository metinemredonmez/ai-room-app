ENV=development
# Shared secret with the backend (AI_INTERNAL_TOKEN), ≥ 32 chars
INTERNAL_TOKEN=
# mock | gemini | replicate   (mock is refused when ENV=production)
IMAGE_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
REPLICATE_API_TOKEN=
REPLICATE_MODEL=black-forest-labs/flux-kontext-pro
# Optional: Claude for design chat, shopping/budget analysis and reference-style description
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
MAX_CONCURRENT_GENERATIONS=4
