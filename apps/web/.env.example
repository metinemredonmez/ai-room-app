# Backend (NestJS) taban URL'si — yalnız sunucu tarafında (BFF) kullanılır, tarayıcıya gönderilmez.
API_BASE_URL=http://localhost:4000/v1

# Uygulamanın tarayıcıdan görünen origin'i. Durum değiştiren isteklerde Origin kontrolü (CSRF) bununla yapılır.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# İsteğe bağlı: backend'in imzalı görsel URL'leri API_BASE_URL'den farklı bir origin'de ise (ör. CDN),
# virgülle ayrılmış liste. CSP img-src ve /api/download izin listesine eklenir.
IMAGE_ORIGINS=
