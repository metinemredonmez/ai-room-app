{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Room AI Service",
    "description": "Internal AI service of AI Room. Only the backend calls it (header `X-Internal-Token`).\n\n* image generation with a provider fallback chain, circuit breakers and a 150 s time budget\n* capture-quality gate, no-change detection\n* Claude design chat and shopping/budget analysis\n* every AI answer carries a `usage` cost-ledger entry (API.md §7.2)\n\nErrors: `{\"error\": {\"code\", \"message\", \"retryable\"}}` — the backend retries only when `retryable` is true.",
    "version": "1.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness (no auth)",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/internal/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Provider chain and circuit-breaker state",
        "operationId": "health_internal_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Internal-Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/internal/v1/generate": {
      "post": {
        "tags": [
          "generation"
        ],
        "summary": "Restyle / edit a room photo (1–4 variants)",
        "operationId": "generate_internal_v1_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong X-Internal-Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Body larger than 40 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Not a JPEG/PNG/WEBP image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`no_change`: every variant matched the input (usage included)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "`ai_unavailable`: providers failed or the 150 s budget ran out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
