  },
  "components": {
    "schemas": {
      "AnalyzeItem": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "material": {
            "type": "string",
            "title": "Material"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "quantity": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Quantity"
          },
          "price_min_try": {
            "type": "number",
            "minimum": 0.0,
            "title": "Price Min Try"
          },
          "price_max_try": {
            "type": "number",
            "minimum": 0.0,
            "title": "Price Max Try"
          },
          "search_query": {
            "type": "string",
            "title": "Search Query"
          }
        },
        "type": "object",
        "required": [
          "name",
          "category",
          "material",
          "color",
          "quantity",
          "price_min_try",
          "price_max_try",
          "search_query"
        ],
        "title": "AnalyzeItem"
      },
      "AnalyzeRequest": {
        "properties": {
          "image_b64": {
            "type": "string",
            "maxLength": 17000000,
            "minLength": 100,
            "title": "Image B64",
            "description": "Base64-encoded JPEG/PNG/WEBP image"
          },
          "locale": {
            "type": "string",
            "enum": [
              "tr",
              "en"
            ],
            "title": "Locale",
            "default": "tr"
          },
          "room": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Room"
          },
          "style_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Style Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "image_b64"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "palette": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Palette"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/AnalyzeItem"
            },
            "type": "array",
            "title": "Items"
          },
          "renovation": {
            "items": {
              "$ref": "#/components/schemas/RenovationItem"
            },
            "type": "array",
            "title": "Renovation"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "summary",
          "palette",
          "items",
          "renovation",
          "disclaimer"
        ],
        "title": "AnalyzeResponse"
      },
      "CatalogEntry": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 40,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "CatalogEntry"
      },
      "ChatCatalog": {
        "properties": {
          "tools": {
            "items": {
              "$ref": "#/components/schemas/CatalogEntry"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Tools"
          },
          "styles": {
            "items": {
              "$ref": "#/components/schemas/CatalogEntry"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Styles"
          },
          "rooms": {
            "items": {
              "$ref": "#/components/schemas/CatalogEntry"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Rooms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ChatCatalog"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "text": {
            "type": "string",
            "maxLength": 2000,
            "title": "Text"
          },
          "image_b64": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 17000000
              },
              {
                "type": "null"
              }
            ],
            "title": "Image B64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "text"
        ],
        "title": "ChatMessage"
      },
      "ChatRequest": {
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "tr",
              "en"
            ],
            "title": "Locale",
            "default": "tr"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Messages"
          },
          "catalog": {
            "$ref": "#/components/schemas/ChatCatalog"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "type": "array",
            "title": "Suggestions"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "reply",
          "suggestions"
        ],
        "title": "ChatResponse"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable",
            "description": "True when the backend may retry the same request"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "usage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Usage"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present when cost was incurred before the failure (e.g. no_change)"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "GenerateRequest": {
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "redesign",
              "furnish",
              "declutter",
              "replace",
              "paint",
              "flooring",
              "exterior",
              "garden",
              "reference",
              "custom"
            ],
            "title": "Tool"
          },
          "image_b64": {
            "type": "string",
            "maxLength": 17000000,
            "minLength": 100,
            "title": "Image B64",
            "description": "Base64-encoded JPEG/PNG/WEBP image"
          },
          "variants": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Variants",
            "default": 1
          },
          "style_prompt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 600
              },
              {
                "type": "null"
              }
            ],
            "title": "Style Prompt"
          },
          "room": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ],
            "title": "Room"
          },
          "floor": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Floor"
          },
          "color_hex": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Hex"
          },
          "color_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Color Name"
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "replacement": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Replacement"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          },
          "remove_all": {
            "type": "boolean",
            "title": "Remove All",
            "default": false
          },
          "reference_image_b64": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 17000000
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Image B64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "image_b64"
        ],
        "title": "GenerateRequest"
      },
      "GenerateResponse": {
        "properties": {
          "images_b64": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Images B64"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "reference_style": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Style"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "type": "object",
        "required": [
          "images_b64",
          "prompt",
          "provider",
          "usage"
        ],
        "title": "GenerateResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "description": "Primary image provider"
          },
          "chat_enabled": {
            "type": "boolean",
            "title": "Chat Enabled"
          },
          "fallbacks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fallbacks"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderState"
            },
            "type": "array",
            "title": "Providers"
          }
        },
        "type": "object",
        "required": [
          "status",
          "provider",
          "chat_enabled",
          "fallbacks",
          "providers"
        ],
        "title": "HealthResponse"
      },
      "ProviderState": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "state": {
            "type": "string",
            "enum": [
              "closed",
              "open",
              "half_open"
            ],
            "title": "State"
          },
          "consecutive_failures": {
            "type": "integer",
            "title": "Consecutive Failures"
          }
        },
        "type": "object",
        "required": [
          "name",
          "state",
          "consecutive_failures"
        ],
        "title": "ProviderState"
      },
      "QualityMetrics": {
        "properties": {
          "brightness": {
            "type": "number",
            "title": "Brightness",
            "description": "Mean luminance 0–255"
          },
          "contrast": {
            "type": "number",
            "title": "Contrast",
            "description": "Luminance standard deviation"
          },
          "sharpness": {
            "type": "number",
            "title": "Sharpness",
            "description": "Edge strength relative to contrast (×100) on a ≤512 px downscale"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
